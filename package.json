{
  "name": "notyloops",
  "type": "module",
  "scripts": {
    "build": "NODE_OPTIONS=--max-old-space-size=4096 nuxt build",
    "precover": "node server/tests/seeds/initializeData.js",
    "cover": "vitest run --coverage",
    "db-migrate": "node server/database/migrate.js run",
    "db-status": "node server/database/migrate.js status",
    "lint": "eslint .",
    "local": "nuxt dev --port 3345",
    "packages": "npx npm-check-updates",
    "sort-package-json": "npx sort-package-json",
    "pdf": "node server/scripts/update-pdf-metadata.js",
    "pretest": "node server/tests/seeds/initializeData.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.145",
    "@nuxt/scripts": "^1.3.12",
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/plausible": "^4.0.0",
    "@nuxtjs/turnstile": "^1.1.3",
    "@sentry/nuxt": "^11.8.0",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "dompurify": "^3.4.17",
    "ejs": "^7.0.1",
    "jsdom": "^30.1.3",
    "katex": "^0.19.0",
    "luxon": "^3.7.2",
    "marked": "^18.1.1",
    "nuxt": "^4.6.2",
    "nuxt-auth-utils": "^0.5.32",
    "nuxt-security": "^2.6.0",
    "pg": "^8.23.1",
    "stripe": "^23.0.0",
    "ts-fsrs": "^5.4.2",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@vitest/coverage-v8": "^5.0.5",
    "dotenv": "^18.0.8",
    "eslint": "^10.13.0",
    "pdf-lib": "^1.17.1",
    "tailwindcss": "^4.3.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "24.x"
  }
}
