# All Sentry settings are optional. Monitoring is off until a DSN is set.
# Nuxt copies only NUXT_PUBLIC_* variables into runtimeConfig.public, which is
# sent to the browser. The client SDK needs this ingest address; it is not secret.
NUXT_PUBLIC_SENTRY_DSN=""
NUXT_PUBLIC_SENTRY_ENVIRONMENT=""
NUXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.1"
SENTRY_ORG=""
SENTRY_PROJECT=""
# Server-only secret used only to upload source maps; never use a NUXT_PUBLIC_ prefix.
SENTRY_AUTH_TOKEN=""
